{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Focus Coach (webcam)",
      "type": "debugpy",
      "request": "launch",
      "module": "app.focus_coach",
      "args": ["--source", "${input:camera}"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Focus Coach (webcam, start at once)",
      "type": "debugpy",
      "request": "launch",
      "module": "app.focus_coach",
      "args": ["--source", "${input:camera}", "--autostart"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Focus Coach (video file)",
      "type": "debugpy",
      "request": "launch",
      "module": "app.focus_coach",
      "args": ["--source", "${input:videoFile}"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Check the camera (5 s test)",
      "type": "debugpy",
      "request": "launch",
      "module": "app.focus_coach",
      "args": ["--source", "${input:camera}", "--check-camera"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "inputs": [
    {
      "id": "camera",
      "type": "promptString",
      "description": "Camera number (0 is the built-in webcam)",
      "default": "0"
    },
    {
      "id": "videoFile",
      "type": "promptString",
      "description": "Path to a video file",
      "default": "demo/examples/scripted_clip.mp4"
    }
  ]
}
